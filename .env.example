# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/routex

# JWT Secrets
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Email Configuration
MAIL_FROM=noreply@routex.com
EMAIL_PROVIDER=smtp

# SMTP Configuration
SMTP_URI=smtp://smtp.gmail.com:587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Payment Integration (Paystack)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key-here
PAYSTACK_CALLBACK_URL=https://your-domain.com/api/webhook/paystack

# Booking System
BOARDING_TOKEN_SECRET=your-boarding-token-secret-here

# Encryption
ENCRYPTION_KEY=your-encryption-key-here
