generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                       String           @id @default(uuid()) @map("id")
    email                    String           @map("email")
    username                 String           @unique @map("username")
    displayPhotoKey          String?          @map("display_photo_key")
    createdAt                DateTime         @default(now()) @map("created_at")
    updatedAt                DateTime         @updatedAt @map("updated_at")
    firstName                String?          @map("first_name")
    lastName                 String?          @map("last_name")
    password                 String           @map("password")
    tenant                   Tenant           @map("tenant")
    emailVerifiedAt          DateTime?        @map("email_verified_at")
    require2Fa               Boolean          @default(false) @map("require_2fa")
    requireEmailVerification Boolean          @default(false) @map("require_email_verification")
    city                     String?          @map("city")
    phone                    String?          @map("phone")
    referralCode             String?          @map("referral_code")
    dateOfBirth              DateTime?        @map("date_of_birth")
    credentialStatus         CredentialStatus @default(ACTIVE) @map("credential_status")
    passwordResetRequired    Boolean          @default(false) @map("password_reset_required")
    twoFactorEnabled         Boolean          @default(false) @map("two_factor_enabled")
    twoFactorSecret          String?          @map("two_factor_secret")
    twoFactorMethod          String?          @map("two_factor_method")
    lockedAt                 DateTime?        @map("locked_at")
    deletedAt                DateTime?        @map("deleted_at")
    suspendedAt              DateTime?        @map("suspend_at")
    blockedAt                DateTime?        @map("blocked_at")
    lockExpiresAt            DateTime?        @map("lock_expires_at")
    pin                      String?
    pinFailedAttempts        Int              @default(0) @map("pin_failed_attempts")
    pinLockedUntil           DateTime?        @map("pin_locked_until")
    backupCodes              BackupCode[]
    bookings                 Booking[]
    wallet                   Wallet?
    transactions             Transaction[]
}

model Admin {
    id                       String           @id @default(uuid()) @map("id")
    email                    String           @map("email")
    password                 String           @map("password")
    username                 String           @unique @map("username")
    firstName                String?          @map("first_name")
    lastName                 String?          @map("last_name")
    phone                    String?          @map("phone")
    createdAt                DateTime         @default(now()) @map("created_at")
    updatedAt                DateTime         @updatedAt @map("updated_at")
    role                     Role             @map("role")
    tenant                   Tenant           @map("tenant")
    emailVerifiedAt          DateTime?        @map("email_verified_at")
    require2Fa               Boolean          @default(false) @map("require_2fa")
    requireEmailVerification Boolean          @default(false) @map("require_email_verification")
    credentialStatus         CredentialStatus @default(ACTIVE) @map("credential_status")
    passwordResetRequired    Boolean          @default(false) @map("password_reset_required")
    twoFactorEnabled         Boolean          @default(false) @map("two_factor_enabled")
    twoFactorSecret          String?          @map("two_factor_secret")
    twoFactorMethod          String?          @map("two_factor_method")
    lockedAt                 DateTime?        @map("locked_at")
    deletedAt                DateTime?        @map("deleted_at")
    suspendedAt              DateTime?        @map("suspended_at")
    blockedAt                DateTime?        @map("blocked_at")
    lockExpiresAt            DateTime?        @map("lock_expires_at")
    backupCodes              BackupCode[]
    transactions             Transaction[]
}

model BackupCode {
    id        String   @id @default(uuid())
    userId    String?
    user      User?    @relation(fields: [userId], references: [id])
    code      String
    used      Boolean  @default(false)
    createdAt DateTime @default(now())
    admin     Admin?   @relation(fields: [adminId], references: [id])
    adminId   String?
    driver    Driver?  @relation(fields: [driverId], references: [id])
    driverId  String?
}

model Session {
    id         String    @id @unique @map("id")
    tokenHash  String    @unique @map("token_hash")
    expiresAt  DateTime  @map("expires_at")
    createdAt  DateTime  @default(now()) @map("created_at")
    updatedAt  DateTime  @updatedAt @map("updated_at")
    userId     String    @map("user_id")
    deviceId   String    @map("device_id")
    ipAddress  String?   @map("ip_address")
    userAgent  String?   @map("user_agent")
    lastSeenAt DateTime? @map("last_seen_at")
    deviceName String?   @map("device_name")
}

model Intent {
    id     String       @id @default(uuid())
    userId String
    type   IntentType
    status IntentStatus @default(CREATED)

    payload Json

    meta Json?

    requiredAuthMethods AuthorizationMethod[]
    minAuthSatisfied    Int

    authorizedAt DateTime?
    expiresAt    DateTime

    executedAt DateTime?
    failedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    authorizationAttempts AuthorizationAttempt[]

    @@index([userId])
    @@index([status])
    @@index([expiresAt])
}

model AuthorizationAttempt {
    id          String                     @id @default(cuid())
    intentId    String
    method      AuthorizationMethod
    status      AuthorizationAttemptStatus
    attemptedAt DateTime                   @default(now())

    /// Optional metadata (IP, device, etc.)
    meta Json?

    intent Intent @relation(fields: [intentId], references: [id], onDelete: Cascade)

    @@index([intentId])
    @@index([intentId, method])
}

model VerificationToken {
    id        String    @id @default(uuid()) @map("id")
    email     String?
    userId    String?
    token     String    @map("token")
    type      TokenType @map("type")
    createdAt DateTime  @default(now()) @map("created_at")
    expiresAt DateTime  @map("expires_at")
}

model Notification {
    id        String   @id @default(uuid())
    userId    String
    tenant    Tenant
    type      String
    title     String
    message   String
    metadata  Json?
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    @@index([userId, isRead])
}

// Booking 

model Location {
    id        String @id @default(uuid())
    name      String
    latitude  Float
    longitude Float

    startRoutes             Route[]          @relation("RouteStart")
    endRoutes               Route[]          @relation("RouteEnd")
    routeStops              RouteStop[]
    tripStopStatuses        TripStopStatus[]
    boardingBookings        Booking[]        @relation("BoardingStop")
    alightingBookings       Booking[]        @relation("AlightingStop")
    boardingPassengerTrips  PassengerTrip[]  @relation("BoardingStop")
    alightingPassengerTrips PassengerTrip[]  @relation("AlightingStop")
}

model Vehicle {
    id            String         @id @default(uuid())
    name          String
    totalSeats    Int
    type          String?
    trips         Trip[]
    tripSchedules TripSchedule[]
}

model Route {
    id                   String   @id @default(uuid())
    code                 String   @unique
    startLocationId      String
    endLocationId        String
    basePrice            Int
    distanceKm           Int
    estimatedDurationMin Int
    startLocation        Location @relation("RouteStart", fields: [startLocationId], references: [id])
    endLocation          Location @relation("RouteEnd", fields: [endLocationId], references: [id])

    trips         Trip[]
    routeStops    RouteStop[]
    tripSchedules TripSchedule[]
}

model RouteStop {
    id                 String   @id @default(uuid())
    routeId            String
    stopId             String
    sequence           Int
    role               StopRole @default(PICKUP_AND_DROPOFF)
    departureOffsetMin Int?

    route Route    @relation(fields: [routeId], references: [id])
    stop  Location @relation(fields: [stopId], references: [id])

    @@unique([routeId, sequence])
}

model Trip {
    id              String     @id @default(uuid())
    code            String     @unique
    routeId         String
    vehicleId       String
    driverId        String?
    departureTime   DateTime
    boardingOpensAt DateTime?
    availableSeats  Int
    priceOverride   Int?
    status          TripStatus @default(SCHEDULED)
    route           Route      @relation(fields: [routeId], references: [id])
    vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
    driver          Driver?    @relation(fields: [driverId], references: [id])

    outboundBookings Booking[]        @relation("OutboundTrip")
    returnBookings   Booking[]        @relation("ReturnTrip")
    tripStopStatuses TripStopStatus[]
    tripSchedule     TripSchedule?    @relation(fields: [tripScheduleId], references: [id])
    tripScheduleId   String?
    tripScheduleDate DateTime?        @db.Date
    passengerTrips   PassengerTrip[]

    @@unique([tripScheduleId, tripScheduleDate])
    @@index([driverId])
    @@index([status, departureTime])
    @@index([status, boardingOpensAt])
}

model TripStopStatus {
    id              String     @id @default(uuid())
    tripId          String
    stopId          String
    sequence        Int
    status          StopStatus
    actualArrival   DateTime?
    actualDeparture DateTime?
    role            StopRole   @default(PICKUP_AND_DROPOFF)

    trip Trip     @relation(fields: [tripId], references: [id])
    stop Location @relation(fields: [stopId], references: [id])

    @@unique([tripId, stopId])
}

model Booking {
    id                   String        @id @default(uuid())
    userId               String
    outboundTripId       String
    returnTripId         String?
    totalPrice           Int
    reservationExpiresAt DateTime
    pricePerSeat         Int
    boardingStopId       String
    alightingStopId      String
    paidAt               DateTime?
    refundedAt           DateTime?
    cancellationFee      Int?
    status               BookingStatus @default(PENDING)
    createdAt            DateTime      @default(now())
    user                 User          @relation(fields: [userId], references: [id])
    boardingStop         Location      @relation("BoardingStop", fields: [boardingStopId], references: [id])
    alightingStop        Location      @relation("AlightingStop", fields: [alightingStopId], references: [id])

    outboundTrip Trip          @relation("OutboundTrip", fields: [outboundTripId], references: [id])
    returnTrip   Trip?         @relation("ReturnTrip", fields: [returnTripId], references: [id])
    passengers   Passenger[]
    transactions Transaction[]
}

model TripSchedule {
    id               String            @id @default(uuid())
    routeId          String
    vehicleId        String
    departureTime    String // time of day, e.g. 08:30
    arrivalOffsetMin Int
    startDate        DateTime          @db.Date
    endDate          DateTime?         @db.Date
    recurrence       RecurrencePattern
    daysOfWeek       Int[]
    isActive         Boolean           @default(true)
    route            Route             @relation(fields: [routeId], references: [id])
    vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])

    trips Trip[]
}

model Passenger {
    id             String          @id @default(uuid())
    bookingId      String
    firstName      String
    lastName       String
    phoneNumber    String
    email          String?
    code           String          @unique
    booking        Booking         @relation(fields: [bookingId], references: [id])
    passengerTrips PassengerTrip[]
}

model PassengerTrip {
    id                    String              @id @default(uuid())
    passengerId           String
    tripId                String
    boardingStopId        String
    alightingStopId       String
    status                PassengerTripStatus @default(RESERVED)
    boardingToken         String?
    seatNo                Int?
    boardedAt             DateTime?
    alightedAt            DateTime?
    boardingAttemptedAt   DateTime?
    boardingFailureReason String?

    passenger     Passenger @relation(fields: [passengerId], references: [id])
    trip          Trip      @relation(fields: [tripId], references: [id])
    boardingStop  Location  @relation("BoardingStop", fields: [boardingStopId], references: [id])
    alightingStop Location  @relation("AlightingStop", fields: [alightingStopId], references: [id])

    @@unique([passengerId, tripId])
}

model Driver {
    id                       String           @id @default(uuid()) @map("id")
    email                    String           @map("email")
    password                 String           @map("password")
    username                 String           @unique @map("username")
    firstName                String?          @map("first_name")
    lastName                 String?          @map("last_name")
    phone                    String?          @map("phone")
    createdAt                DateTime         @default(now()) @map("created_at")
    updatedAt                DateTime         @updatedAt @map("updated_at")
    tenant                   Tenant           @map("tenant")
    emailVerifiedAt          DateTime?        @map("email_verified_at")
    require2Fa               Boolean          @default(false) @map("require_2fa")
    requireEmailVerification Boolean          @default(false) @map("require_email_verification")
    credentialStatus         CredentialStatus @default(ACTIVE) @map("credential_status")
    passwordResetRequired    Boolean          @default(false) @map("password_reset_required")
    twoFactorEnabled         Boolean          @default(false) @map("two_factor_enabled")
    twoFactorSecret          String?          @map("two_factor_secret")
    twoFactorMethod          String?          @map("two_factor_method")
    lockedAt                 DateTime?        @map("locked_at")
    deletedAt                DateTime?        @map("deleted_at")
    suspendedAt              DateTime?        @map("suspended_at")
    blockedAt                DateTime?        @map("blocked_at")
    lockExpiresAt            DateTime?        @map("lock_expires_at")
    backupCodes              BackupCode[]
    trips                    Trip[]
}

// Wallet

model Wallet {
    id        String   @id @default(uuid())
    userId    String   @unique
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id])
}

model BankAccount {
    id            String   @id @default(uuid())
    bankName      String
    bankCode      String
    accountNumber String
    accountName   String
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    transactions Transaction[]
}

model Transaction {
    id          String                 @id @default(uuid())
    type        TransactionType
    amount      Float // net amount settled 
    gross       Float?
    gatewayFee  Float?
    gateway     String?
    reference   String                 @unique
    reason      String?
    bookingId   String?
    balance     Float? // balance after this transaction
    intent      TransactionIntent
    source      TransactionSource
    destination TransactionDestination
    bankId      String?                @map("bank_id")
    bank        BankAccount?           @relation(fields: [bankId], references: [id])
    description String
    metadata    Json?
    failedAt    DateTime?              @map("failed_at")
    succeededAt DateTime?              @map("succeeded_at")

    status       TransactionStatus @default(PENDING)
    createdAt    DateTime          @default(now())
    approvedById String?

    userId String

    user User @relation(fields: [userId], references: [id])

    approvedBy Admin? @relation(fields: [approvedById], references: [id])

    paymentAttempts PaymentAttempt[]
    booking         Booking?         @relation(fields: [bookingId], references: [id])

    @@index([reference])
}

model PaymentAttempt {
    id String @id @default(uuid())

    transactionId String
    gateway       String
    status        PaymentAttemptStatus @default(PENDING)

    requestPayload  Json? @map("request_payload")
    responsePayload Json? @map("response_payload")

    errorCode    String? @map("error_code")
    errorMessage String? @map("error_message")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    transaction Transaction @relation(fields: [transactionId], references: [id])
}

enum PassengerTripStatus {
    RESERVED
    SCHEDULED
    BOARDED
    COMPLETED
    NO_SHOW
    CANCELLED
}

enum PaymentAttemptStatus {
    PENDING
    SUCCESS
    FAILED
}

enum TransactionIntent {
    WALLET_TOPUP
    BOOKING_PAYMENT
    BOOKING_CANCELLATION_FEE
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
    EXPIRED
}

enum PaymentSource {
    PAYSTACK
    WALLET
}

enum TransactionDestination {
    WALLET
    BANK_ACCOUNT
    PLATFORM
}

enum TransactionType {
    CREDIT
    DEBIT
}

enum TransactionSource {
    INSTANT_TRANSFER
    WALLET
    CARD
    PLATFORM
}

enum TransactionStatus {
    PENDING
    SUCCESS
    FAILED

    @@map("WalletTransactionStatus")
}

enum AuthorizationAttemptStatus {
    SUCCESS
    FAILURE
}

enum IntentStatus {
    CREATED
    AUTHORIZED
    EXECUTED
    FAILED
    EXPIRED
}

enum TripStatus {
    SCHEDULED
    BOARDING
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum StopRole {
    PICKUP_ONLY
    DROPOFF_ONLY
    PICKUP_AND_DROPOFF
}

enum Tenant {
    USER
    DRIVER
    ADMIN
}

enum CredentialStatus {
    ACTIVE
    SUSPENDED
    LOCKED
    DELETED
    BLOCKED
}

enum Role {
    ADMIN
    SUPERADMIN
}

enum IntentType {
    EMPTY
    CANCEL_BOOKING
    REFUND_BOOKING
}

enum AuthorizationMethod {
    PASSWORD
    OTP
    TOTP
}

enum TokenType {
    EMAIL_VERIFICATION
    PASSWORD_RESET
}

enum StopStatus {
    PENDING
    ARRIVED
    DEPARTED
    SKIPPED
}

enum RecurrencePattern {
    DAILY
    WEEKLY
}
